local function showKeySystem()
    local keyGui = Instance.new("ScreenGui")
    keyGui.Name = "DynamicKeySystem"
    keyGui.IgnoreGuiInset = true
    keyGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    keyGui.DisplayOrder = 500
    
    if syn and syn.protect_gui then
        syn.protect_gui(keyGui)
        keyGui.Parent = CoreGui
    elseif gethui then
        keyGui.Parent = gethui()
    else
        pcall(function() keyGui.Parent = CoreGui end)
        if not keyGui.Parent then keyGui.Parent = player:WaitForChild("PlayerGui") end
    end
    
    local keyFrame = Instance.new("Frame")
    keyFrame.Size = UDim2.new(0, 380, 0, 170)
    keyFrame.Position = UDim2.new(0.5, -190, 0.5, -85)
    keyFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    keyFrame.BackgroundTransparency = 0.05
    keyFrame.BorderSizePixel = 0
    keyFrame.ZIndex = 20
    keyFrame.Parent = keyGui
    
    local kCorner = Instance.new("UICorner")
    kCorner.CornerRadius = UDim.new(0, 6)
    kCorner.Parent = keyFrame
    
    local kStroke = Instance.new("UIStroke")
    kStroke.Color = Color3.fromRGB(45, 45, 55)
    kStroke.Thickness = 1
    kStroke.Parent = keyFrame
    
    local kTitle = Instance.new("TextLabel")
    kTitle.Size = UDim2.new(1, -60, 0, 25)
    kTitle.Position = UDim2.new(0, 15, 0, 18)
    kTitle.BackgroundTransparency = 1
    kTitle.Font = Enum.Font.Code
    kTitle.Text = "AUTHENTICATION REQUIRED"
    kTitle.TextColor3 = Color3.fromRGB(220, 220, 225)
    kTitle.TextSize = 12
    kTitle.TextXAlignment = Enum.TextXAlignment.Left
    kTitle.ZIndex = 21
    kTitle.Parent = keyFrame

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 25, 0, 25)
    closeBtn.Position = UDim2.new(1, -30, 0, 16)
    closeBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
