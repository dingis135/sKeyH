    textBox.TextColor3 = Color3.fromRGB(240, 240, 245)
    textBox.PlaceholderColor3 = Color3.fromRGB(90, 90, 100)
    textBox.TextSize = 12
    textBox.ZIndex = 21
    textBox.Parent = keyFrame
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = textBox
    
    local submitBtn = Instance.new("TextButton")
    submitBtn.Size = UDim2.new(0, 100, 0, 30)
    submitBtn.Position = UDim2.new(1, -115, 0, 105)
    submitBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    submitBtn.BorderSizePixel = 0
    submitBtn.Font = Enum.Font.GothamMedium
    submitBtn.Text = "Verify"
    submitBtn.TextColor3 = Color3.fromRGB(220, 220, 225)
    submitBtn.TextSize = 12
    submitBtn.ZIndex = 21
    submitBtn.Parent = keyFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = submitBtn
    
    local feedback = Instance.new("TextLabel")
    feedback.Size = UDim2.new(1, -140, 0, 30)
    feedback.Position = UDim2.new(0, 15, 0, 105)
    feedback.BackgroundTransparency = 1
    feedback.Font = Enum.Font.Gotham
    feedback.Text = ""
    feedback.TextColor3 = Color3.fromRGB(210, 90, 90)
    feedback.TextSize = 11
    feedback.TextXAlignment = Enum.TextXAlignment.Left
    feedback.ZIndex = 21
    feedback.Parent = keyFrame

    submitBtn.MouseButton1Click:Connect(function()
        local inputKey = textBox.Text
        if inputKey == "" then
            feedback.TextColor3 = Color3.fromRGB(210, 90, 90)
            feedback.Text = "Key field cannot be empty."
            return
        end
        
        local keyData = validKeys[inputKey]
        if keyData then
            pcall(function() writefile(KeyFileName, inputKey) end)
            feedback.TextColor3 = Color3.fromRGB(100, 210, 120)
            feedback.Text = "Access granted."
            task.wait(0.4)
            keyGui:Destroy()
            launchHubPayload()
        else
            feedback.TextColor3 = Color3.fromRGB(210, 90, 90)
            feedback.Text = "Invalid access key."
        end
    end)
end

-- Session Cache Check
local hasCachedKey = false
if pcall(function() return readfile(KeyFileName) end) then
    local cachedKey = readfile(KeyFileName)
    if validKeys[cachedKey] then
        hasCachedKey = true
        launchHubPayload()
    end
end

if not hasCachedKey then
    showKeySystem()
end
